# Development environment — a SEPARATE Supabase project from production.
#
# Copy this to `.env.development.local` and fill in from your dev Supabase
# project. Next.js loads `.env.development.local` ahead of `.env.local` when you
# run `npm run dev`, so the app points at dev automatically while the production
# values in `.env.local` stay put for the migration scripts.
#
# Never point this at the production project. `npm run dev:migrate` applies
# schema changes to whatever this file names.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# How the migration scripts reach the database. Set EITHER of these; neither is
# ever used by the app at runtime, only by scripts/*.mjs.
#
# Preferred — an account token, from https://supabase.com/dashboard/account/tokens
# Runs SQL over HTTPS, so it needs no database password and works on networks
# that block the Postgres port. The project is identified by
# NEXT_PUBLIC_SUPABASE_URL above, so this token is the only thing to paste.
# It grants access to your whole Supabase account: keep it in this gitignored
# file only, and revoke it from that page if it ever leaks.
SUPABASE_ACCESS_TOKEN=

# Alternative — a direct Postgres connection.
# Supabase → Settings → Database → Connection string → URI (insert your password).
# Harder to get right: the password is shown once, lives inside a URL, and a
# wrong one is indistinguishable from an unsaved one.
SUPABASE_DB_URL=

# Where links in emails point. Keep this local so a dev email can never send a
# client to production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts stored Slack webhooks AND Figma tokens (despite the name).
# Generate a DEV-ONLY value — never reuse production's, and never rotate
# production's, or every stored integration becomes undecryptable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIGMA_TOKEN_SECRET=

# Leave RESEND_API_KEY unset in development: lib/email/send.ts logs and skips,
# so no real client can ever receive a test email. Set it only to test delivery,
# and then use a verified test address.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Any value; only the cron route checks it.
CRON_SECRET=dev-only-not-a-secret
